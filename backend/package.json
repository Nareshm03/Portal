{
  "name": "portal-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --test --watch --test-concurrency=1",
    "check": "node --check src/index.js && node --test --test-concurrency=1",
    "expire-orders": "node src/jobs/expireOrders.js",
    "reconcile-payments": "node src/jobs/reconcilePayments.js",
    "worker": "node src/worker.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "razorpay": "^2.9.6",
    "zod": "^4.1.5"
  }
}
