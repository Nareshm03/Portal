{
  "name": "portal-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Portal backend — Express API for cross-border shopping marketplace",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --test --watch --test-concurrency=1",
    "check": "node --check src/index.js && node --test --test-concurrency=1",
    "expire-orders": "node src/jobs/expireOrders.js",
    "reconcile-payments": "node src/jobs/reconcilePayments.js",
    "worker": "node src/worker.js"
  },
  "keywords": [],
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "razorpay": "^2.9.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
