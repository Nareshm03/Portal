NODE_ENV=development
PORT=4000
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HOPS=0

# Required for authenticated endpoints. Keep the service-role key on the server only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Start in demo mode. Real payment routes remain disabled until compliance approval.
MOCK_PAYMENTS=true
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Never commit this value. Use a long random secret from a secret manager in production.
OTP_PEPPER=replace_with_at_least_32_random_bytes

# OTP delivery provider: 'mock' (development only) or 'msg91' (production).
OTP_PROVIDER=mock

# MSG91 SendOTP V5 configuration (required when OTP_PROVIDER=msg91).
# Obtain these from the MSG91 dashboard. Never commit real values.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Indicative policy defaults only. Confirm fee/deposit semantics with the team before launch.
PLATFORM_FEE_BPS=500
BUYER_DEPOSIT_BPS=2500
QUOTE_TTL_MINUTES=15
ORDER_PAYMENT_TTL_MINUTES=15

# Server-side FX source. No user-supplied exchange rates are accepted.
FX_PROVIDER=manual
FX_RATE_TABLE_JSON={"USD":{"INR":"83.500000"},"EUR":{"INR":"90.500000"},"GBP":{"INR":"105.000000"},"SGD":{"INR":"62.000000"}}
FX_RATE_SOURCE=DEMO_CONFIG


# Razorpay Test Mode Configuration
# Use these for testing without real transactions
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_USE_TEST_MODE=false

# To use test mode:
# 1. Set MOCK_PAYMENTS=false
# 2. Set PAYMENTS_ENABLED=true
# 3. Set RAZORPAY_USE_TEST_MODE=true
# 4. Add your Razorpay test credentials from Razorpay dashboard
# 5. For production with test mode, ensure NODE_ENV=production and RAZORPAY_USE_TEST_MODE=true